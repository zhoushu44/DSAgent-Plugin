{
  "schema": "dsagent/skill-contract@1",
  "id": "bilibili-crawl",
  "entry": {
    "form": "script",
    "script": "scripts/fetch_data.py"
  },
  "input": {
    "args": [
      {
        "name": "mode",
        "choices": [
          "",
          "video",
          "user",
          "up",
          "profile",
          "search",
          "user-search",
          "ranking",
          "hot",
          "related",
          "comment"
        ],
        "default": ""
      },
      {
        "name": "bvid",
        "default": ""
      },
      {
        "name": "aid",
        "default": ""
      },
      {
        "name": "mid",
        "default": ""
      },
      {
        "name": "keyword",
        "default": ""
      },
      {
        "name": "count",
        "type": "integer",
        "default": 20
      },
      {
        "name": "page",
        "type": "integer",
        "default": 1
      }
    ]
  },
  "output": {
    "protocol": "dsagent-result",
    "resultPrefix": "__DSAGENT_RESULT__",
    "filesMarker": "---[OUTPUT_FILES]"
  }
}
