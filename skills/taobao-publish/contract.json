{
  "schema": "dsagent/skill-contract@1",
  "id": "taobao-publish",
  "entry": {
    "form": "script",
    "script": "scripts/publish.py"
  },
  "input": {
    "args": [
      {
        "required": true,
        "name": "images",
        "description": "本地主图绝对路径，1~5 张，单张 ≤3MB"
      },
      {
        "required": true,
        "name": "title",
        "description": "商品标题（≤60 字）"
      },
      {
        "description": "渠道：taobao（默认）/ tmall",
        "name": "channel"
      },
      {
        "description": "一口价（元）",
        "name": "price"
      },
      {
        "description": "库存（件）",
        "name": "stock"
      },
      {
        "flag": "--itemNo",
        "name": "itemNo",
        "description": "商家编码/货号"
      },
      {
        "description": "多规格 JSON 数组字符串",
        "name": "skus"
      },
      {
        "description": "选类目关键词（具体叶子类目词）",
        "name": "categoryKeyword"
      },
      {
        "description": "品牌（部分类目必填）",
        "name": "brand"
      },
      {
        "description": "型号（部分类目必填）",
        "name": "model"
      },
      {
        "description": "Json 劫持重放模式：true/false",
        "name": "replayMode"
      },
      {
        "description": "确认发布：true 才真正提交；省略/false 只返回发布预览，不产生任何写操作",
        "name": "confirm"
      },
      {
        "description": "账号 shopKey（可选）；该平台多账号且未绑定时需先向用户确认",
        "name": "account"
      }
    ]
  },
  "output": {
    "protocol": "dsagent-result",
    "resultPrefix": "__DSAGENT_RESULT__",
    "filesMarker": "---[OUTPUT_FILES]"
  }
}
