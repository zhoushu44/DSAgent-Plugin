{
  "$comment": "京东商家后台发布锚点集（wares-jdm.jd.com）。★ 状态：语义锚点层（L2/L3）先行，尚未真机逐格实测 —— 首次发布会输出 DOM 诊断（可见 input / button / file 清单 + 截图），按诊断把 L2 锚点替换成 L1 埋点即可，无需改代码（改本文件热生效）。分级规范见 PUBLISH-SPEC.md §3.3。",
  "platform": "jd",
  "version": 1,
  "limits": {
    "maxImageBytes": 3145728,
    "maxImages": 5,
    "maxTitleLen": 60,
    "maxDetailImages": 30,
    "defaultStock": "999"
  },
  "urls": {
    "goodsList": "https://wares-jdm.jd.com/ware/list",
    "jdPublish": "https://wares-jdm.jd.com/newPublish",
    "jdPopPublish": "https://wares-jdm.jd.com/popPublish"
  },
  "cookieDomains": [".jd.com"],
  "loginUrlRe": "passport\\.jd\\.com|\\/login",
  "riskSelector": "#baxia-dialog-content, .JDJRV-slide, [class*=\"captcha\"], [class*=\"risk\"]",
  "flow": [
    { "step": "openEntry", "url": "https://wares-jdm.jd.com/newPublish" },
    { "step": "selectCategory" },
    { "step": "waitFor", "match": "input[placeholder*=\"商品名称\"], input[placeholder*=\"商品标题\"], text:商品信息" },
    { "step": "fillTitle" },
    { "step": "uploadMainImages" },
    { "step": "fillSku" },
    { "step": "fillAttributes" },
    { "step": "fillFreight" },
    { "step": "submit", "args": { "buttonTextRe": "^(提交并上架|提交商品|提交|保存并上架|发布商品|发布)$" } }
  ],
  "anchors": {
    "formReady": {
      "candidates": [
        { "level": 1, "selector": "input[placeholder*=\"商品名称\"]" },
        { "level": 2, "selector": "input[placeholder*=\"商品标题\"]" },
        { "level": 3, "selector": "text:商品信息" },
        { "level": 3, "selector": "text:商品主图" }
      ]
    },
    "cateSearchInput": {
      "candidates": [
        { "level": 2, "selector": "input[placeholder*=\"搜索类目\"]" },
        { "level": 2, "selector": "input[placeholder*=\"类目关键词\"]" },
        { "level": 3, "selector": "input[placeholder*=\"类目\"]" }
      ]
    },
    "cateResultItem": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"category-result\"] li" },
        { "level": 2, "selector": "[class*=\"cate-result\"] li" },
        { "level": 3, "selector": "[class*=\"cascader\"] li" },
        { "level": 3, "selector": "[class*=\"dropdown\"] li" }
      ]
    },
    "cateConfirmButton": {
      "candidates": [
        { "level": 2, "selector": "text:确认，下一步" },
        { "level": 2, "selector": "text:确认下一步" },
        { "level": 3, "selector": "text:下一步" },
        { "level": 3, "selector": "text:确定" }
      ]
    },
    "catePathText": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"cate-path\"]" },
        { "level": 3, "selector": "[class*=\"category-path\"]" }
      ]
    },
    "titleInput": {
      "candidates": [
        { "level": 1, "selector": "input[placeholder*=\"商品名称\"]" },
        { "level": 2, "selector": "input[placeholder*=\"商品标题\"]" },
        { "level": 2, "selector": "input[name=\"wareName\"]" },
        { "level": 3, "selector": "input[name=\"title\"]" }
      ],
      "fillFieldFallbackRe": "商品名称|商品标题|标题"
    },
    "priceInput": {
      "candidates": [
        { "level": 2, "selector": "input[placeholder*=\"京东价\"]" },
        { "level": 2, "selector": "input[placeholder*=\"售价\"]" },
        { "level": 3, "selector": "input[name=\"jdPrice\"]" }
      ],
      "fillFieldFallbackRe": "京东价|售价|价格"
    },
    "stockInput": {
      "candidates": [
        { "level": 2, "selector": "input[placeholder*=\"库存\"]" },
        { "level": 3, "selector": "input[name=\"stock\"]" }
      ],
      "fillFieldFallbackRe": "库存|可售数量"
    },
    "itemNoInput": {
      "candidates": [
        { "level": 2, "selector": "input[placeholder*=\"商品编号\"]" },
        { "level": 2, "selector": "input[placeholder*=\"货号\"]" },
        { "level": 3, "selector": "input[placeholder*=\"商家编码\"]" }
      ],
      "fillFieldFallbackRe": "商品编号|货号|商家编码"
    },
    "mainImageInput": {
      "candidates": [
        { "level": 1, "selector": "input[type=\"file\"][accept*=\"image\"]" },
        { "level": 3, "selector": "input[type=\"file\"]" }
      ],
      "comment": "京东主图区多包一层上传组件；优先直投 file input，落空时点上传区等 fileChooser"
    },
    "mainImageZone": {
      "candidates": [
        { "level": 2, "selector": "text:商品主图" },
        { "level": 3, "selector": "[class*=\"main-image\"]" },
        { "level": 3, "selector": "[class*=\"mainImage\"]" }
      ]
    },
    "detailImageInput": {
      "candidates": [
        { "level": 3, "selector": "textarea ~ input[type=\"file\"]" },
        { "level": 3, "selector": "[class*=\"detail\"] input[type=\"file\"]" }
      ]
    },
    "specSection": {
      "candidates": [
        { "level": 2, "selector": "text:销售属性" },
        { "level": 3, "selector": "[class*=\"sale-attr\"]" },
        { "level": 3, "selector": "[class*=\"saleAttr\"]" },
        { "level": 3, "selector": "[class*=\"sku\"]" }
      ]
    },
    "specInput": {
      "candidates": [
        { "level": 2, "selector": "input[placeholder*=\"规格值\"]" },
        { "level": 2, "selector": "input[placeholder*=\"颜色\"]" },
        { "level": 3, "selector": "input[placeholder*=\"添加\"]" }
      ],
      "comment": "京东销售属性同样是受控输入：键入后必须 Tab（onBlur）才进 state"
    },
    "skuTableRow": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"sku-table\"] tbody tr" },
        { "level": 2, "selector": "table tbody tr[class*=\"sku\"]" },
        { "level": 3, "selector": "[class*=\"sku\"] table tbody tr" }
      ]
    },
    "attrItem": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"attr-item\"]" },
        { "level": 2, "selector": "[class*=\"attribute-item\"]" },
        { "level": 3, "selector": "[class*=\"prop-item\"]" },
        { "level": 3, "selector": "[class*=\"property-item\"]" }
      ]
    },
    "attrLabel": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"attr-label\"], [class*=\"attr-name\"], label, dt" }
      ]
    },
    "attrRequiredMark": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"required\"], .required, [class*=\"important\"]" }
      ]
    },
    "attrDropdownPanel": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"dropdown\"][class*=\"open\"]" },
        { "level": 2, "selector": "[class*=\"select-list\"]" },
        { "level": 3, "selector": "[class*=\"popover\"]" },
        { "level": 3, "selector": "[role=\"listbox\"]" }
      ],
      "comment": "body 级 portal，取最后一个可见面板"
    },
    "attrOption": {
      "candidates": [
        { "level": 2, "selector": "li, [role=\"option\"], [class*=\"option\"]" }
      ]
    },
    "freightZone": {
      "candidates": [
        { "level": 2, "selector": "text:运费模板" },
        { "level": 3, "selector": "text:物流服务" },
        { "level": 3, "selector": "[class*=\"freight\"]" }
      ]
    },
    "freightSelect": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"freight\"] input" },
        { "level": 3, "selector": "[class*=\"template\"] input" }
      ]
    },
    "submitButton": {
      "candidates": [
        { "level": 2, "selector": "text:提交并上架" },
        { "level": 2, "selector": "text:保存并上架" },
        { "level": 3, "selector": "text:发布商品" },
        { "level": 3, "selector": "text:提交" }
      ],
      "matchTextRe": "^(提交并上架|保存并上架|提交商品|提交|发布商品|发布)$"
    },
    "errorToast": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"toast\"], [class*=\"message\"][class*=\"show\"], [class*=\"notice\"]" }
      ],
      "excludeTextRe": "提交成功|发布成功|保存成功"
    },
    "errorField": {
      "candidates": [
        { "level": 2, "selector": "[class*=\"error\"], [class*=\"Error\"], [class*=\"invalid\"]" }
      ]
    },
    "successRe": "发布成功|提交成功|上架成功|保存成功|商品已提交",
    "uploadFailure": "图片格式不正确|文件过大|超过大小限制|不支持的文件|上传失败"
  },
  "fieldStrategies": {
    "title": { "type": "type", "anchor": "titleInput", "maxLength": 60, "source": "data.title" },
    "price": { "type": "type", "anchor": "priceInput", "source": "data.price" },
    "stock": { "type": "type", "anchor": "stockInput", "source": "data.stock", "default": "999" },
    "itemNo": { "type": "type", "anchor": "itemNoInput", "source": "data.itemNo" },
    "category": { "type": "categorySearch", "levels": 3 }
  },
  "regexes": {
    "attrSkip": "^品牌$",
    "salePropPlaceholder": "规格值|颜色|尺码|尺寸",
    "step2Url": "newPublish|popPublish|ware\\/add"
  },
  "timeouts": {
    "formWaitMs": 150000,
    "publishTimeoutMs": 180000,
    "uploadWaitMs": 90000,
    "skuCellWaitMs": 500,
    "attrModelTimeoutMs": 20000,
    "attrDropdownWaitMs": 800
  }
}
