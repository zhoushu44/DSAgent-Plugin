{
  "name": "@dsagent/dsagent-plugin",
  "version": "1.0.0",
  "description": "DSH 插件：账号连接器 + 技能市场，为模型注册 5 个只读工具（账号查询、健康检查、技能列表、技能详情、平台列表），浏览器侧提供账号连接页与技能市场页。 · DSH plugin: account connector + skill market — registers 5 read-only tools and a dual-tab browser UI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "account",
    "skill",
    "market"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "build:host": "tsc -p tsconfig.json",
    "smoke": "node dev/smoke-client.mjs",
    "build": "npm run typecheck && npm run build:host && node dev/build-client.mjs && node dev/smoke-client.mjs",
    "build:client": "node dev/build-client.mjs && node dev/smoke-client.mjs",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.4"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "puppeteer-core": "^23.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
