# 依赖
node_modules/

# Python 字节码缓存（随解释器版本全量变更，无提交价值）
__pycache__/
*.pyc

# 构建产物
lib/
dist/

# 绿色版打包的中间产物与产物
# 仓库里只放「能重建出绿色包的脚本」（dev/portable/），产物一律不入库：
#   · 完整包 ~1.2 GB，入库会让 clone/pull 变得不可用
#   · 内含 DSH Desktop 程序与便携 Python，版权不属于本项目
dist/DSAgent-Portable/
dist/DSAgent-Portable.zip
*.tgz

# 敏感数据
*.env
.env*
*.key
*.pem
**/dsagent-accounts*.json
**/credentials*.json
**/credentials*.yaml

# IDE
.trae/

# 系统文件
.DS_Store
Thumbs.db

# ── Accio 逆向分析的临时解包目录 ──
# 这些是 Electron 应用（app.asar）的解包产物，属第三方厂商代码：
#   · 体积巨大（合计 ~320MB），不该进仓库
#   · 版权不属于本项目，入库有合规风险
#   · 需要重读时用 dev/accio-analysis/unpack-asar.mjs 重新解包即可
.tmp-accio/
_accio_probe/
accio-app/
accio_extracted/
dev/accio-analysis/
accio_files.txt

# 分析与验证的落盘产物（每次运行都会重建）
artifacts/
*_payload_*.json
.skill-stats.json
.pitfall-memory.json

# verify-commit-tree.mjs 的隔离 worktree 临时目录
# 放在工作区内是刻意的：系统临时目录下 esbuild 写 bundle 会被拒（Access is denied）
.commit-verify-*/

# 其它会话的暂存目录
kb-stage/
accio-staging/

# npm 本地缓存（某些环境会把 cache 落在仓库内）
.npm-cache/
