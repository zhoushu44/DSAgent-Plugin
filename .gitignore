# ── 凭据与调试产物：一律不入库 ──────────────────────────────
# 真实登录态 / Cookie / 二维码 / 登录截图，任何形式都不进仓库
# （dev/tmp-pdd-cookies.json 曾含 PASS_ID + JSESSIONID，属高危）
dev/tmp-*.json
dev/tmp-*.png
dev/tmp-*.cjs
dev/tmp-*.js
dev/*cookies*.json
dev/*cookie*.json
**/tmp-*-cookies.json
**/*cookie*.json
!dev/portable/**
*.pdd-cookies.json

# 多智能体协作的临时工作区与数据库
.swarm*/
.swarm*.db

# 账号 / 商品 / 会话类本地数据
dev/acc-product-*.json
dsagent-accounts*.json

# 截图与探针产物
dev/.ui-shots/
.tmp-accio/
dev/accio-analysis/

# 系统杂物
Thumbs.db
desktop.ini
.DS_Store

# ── 构建产物（TS 编译输出，不入库） ───────────────────────
lib/**/*.js
lib/**/*.js.map
lib/**/*.d.ts
!lib/pdd-publish.js
!lib/pdd-mode2.js
!lib/pdd-publish2.js

# ── Python 缓存 ───────────────────────────────────────────
__pycache__/
*.pyc
.dsagent/runtime/__pycache__/

# ── 本地运行产物 ──────────────────────────────────────────
artifacts/
.trae/

