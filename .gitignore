# ── 凭据与调试产物：一律不入库 ──────────────────────────────
# 真实登录态 / Cookie / 二维码 / 登录截图，任何形式都不进仓库
# （dev/tmp-pdd-cookies.json 曾含 PASS_ID + JSESSIONID，属高危）
# 技能本地凭据目录（如 xiaohongshu-analytics/.secrets/login.json 存 Cookie）
**/.secrets/
skills/**/.tmp-*
dev/tmp-*.json
dev/tmp-*.png
dev/tmp-*.cjs
dev/tmp-*.js
dev/tmp-*.ps1
dev/tmp-*.txt
dev/*cookies*.json
dev/*cookie*.json
**/tmp-*-cookies.json
**/*cookie*.json
!dev/portable/**
*.pdd-cookies.json

# 依赖与本地构建残留
node_modules/
*.bak-*
*_backup_*/

# 多智能体协作的临时工作区与数据库
.swarm*/
.swarm*.db

# 账号 / 商品 / 会话类本地数据
dev/acc-product-*.json
dsagent-accounts*.json

# 截图与探针产物
dev/.ui-shots/
dev/patrol-evidence/
.tmp-accio/
dev/accio-analysis/

# 系统杂物
Thumbs.db
desktop.ini
.DS_Store

# ── 构建产物（TS 编译输出，不入库） ───────────────────────
lib/**/*.js
lib/**/*.js.map
lib/**/*.d.ts
lib/**/*.d.ts.map
!lib/pdd-publish.js
!lib/pdd-mode2.js
!lib/pdd-publish2.js

# ── Python 缓存 ───────────────────────────────────────────
__pycache__/
*.pyc
.dsagent/runtime/__pycache__/

# ── 本地运行产物 ──────────────────────────────────────────
artifacts/
.trae/
# 本地缓存（SQLite，按机器/账号变化，不入库）
.dsagent/cache/
**/.dsagent/cache/
!skills/.dsagent/**

# ── 第三方 skill 目录（未审核） ───────────────────────────
skills/_re_qianchuan/
skills/taobao-promo/
skills/douyin-plan-ops/contract.json
skills/douyin-uni-prom/contract.json

# ── 测试脚本（本地诊断用，不入库） ────────────────────────
dev/_*.py
dev/_*.txt

# ── 根目录临时调试脚本（本次排查 PDD 时产生，防再堆积）──────
/_*.mjs
/_*.json
/_*.txt
profs.txt
# PDD 登录令牌（真实凭据，绝不入库）
skills/pdd-ai-video/.cache/
**/ptj-token.json
# 测试/审计产物（本地数据，不入库）
skills/_shared/.audit-all.json
skills/_shared/.test-result.json
